<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wartime Censor Simulation</title>
    <!-- Load Tailwind CSS for styling -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Load React, ReactDOM, and Babel for the interactive logic -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/react/18.2.0/umd/react.production.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/react-dom/18.2.0/umd/react-dom.production.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/babel-standalone/7.23.4/babel.min.js"></script>
    <style>
        /* Smooth out scrollbars for the embedded iframe */
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #888; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #555; }
        body, html { margin: 0; padding: 0; height: 100%; width: 100%; background-color: #111827; }
        #root { height: 100%; }
    </style>
</head>
<body>
    <div id="root">
        <!-- This message only shows if the preview viewer blocks the compiler -->
        <div style="display: flex; justify-content: center; align-items: center; height: 100vh; color: #f3f4f6; font-family: ui-sans-serif, system-ui, sans-serif; text-align: center; padding: 2rem;">
            <div>
                <h2 style="font-size: 1.5rem; font-weight: bold; margin-bottom: 1rem;">Loading Simulation...</h2>
                <p style="color: #9ca3af; max-w: md; margin: 0 auto; line-height: 1.5;">
                    If you are seeing this message, the preview environment has blocked the code compiler for security reasons.<br><br>
                    <strong>The simulation is fully functional.</strong> Please copy this entire code block and paste it into your Google Sites "Embed Code" box to run it!
                </p>
            </div>
        </div>
    </div>

    <script type="text/babel">
        const { useState } = React;

        // --- INLINE ICONS ---
        const Icon = ({ path, size = 24, className = "" }) => (
            <svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" className={className}>
                {path}
            </svg>
        );
        const Shield = (p) => <Icon {...p} path={<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>} />;
        const FileText = (p) => <Icon {...p} path={<g><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><line x1="16" x2="8" y1="13" y2="13"/><line x1="16" x2="8" y1="17" y2="17"/><line x1="10" x2="8" y1="9" y2="9"/></g>} />;
        const AlertTriangle = (p) => <Icon {...p} path={<g><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" x2="12" y1="9" y2="13"/><line x1="12" x2="12.01" y1="17" y2="17"/></g>} />;
        const Stamp = (p) => <Icon {...p} path={<g><path d="M5 22h14"/><path d="M8 22v-4"/><path d="M16 22v-4"/><path d="M7 8h10a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-4a2 2 0 0 1 2-2z"/><path d="M9 8V4a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v4"/></g>} />;
        const CheckCircle = (p) => <Icon {...p} path={<g><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></g>} />;
        const XCircle = (p) => <Icon {...p} path={<g><circle cx="12" cy="12" r="10"/><line x1="15" x2="9" y1="9" y2="15"/><line x1="9" x2="15" y1="9" y2="15"/></g>} />;
        const Award = (p) => <Icon {...p} path={<g><circle cx="12" cy="8" r="7"/><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"/></g>} />;
        const ChevronRight = (p) => <Icon {...p} path={<path d="m9 18 6-6-6-6"/>} />;
        const RotateCcw = (p) => <Icon {...p} path={<g><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></g>} />;
        const Info = (p) => <Icon {...p} path={<g><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></g>} />;
        const X = (p) => <Icon {...p} path={<g><path d="M18 6 6 18"/><path d="m6 6 12 12"/></g>} />;
        const BookOpen = (p) => <Icon {...p} path={<g><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></g>} />;

        // --- GAME DATA ---
        const CENSORSHIP_RULES = [
          "1. Specific Locations: Do not allow mention of specific towns, coordinates, or geographical features where troops are stationed.",
          "2. Troop Movements & Dates: Redact any mention of future attacks, times, or movement of divisions.",
          "3. Specific Casualties: Exact numbers of dead or wounded must be hidden to maintain home front morale.",
          "4. Technology & Tactics: Mentions of new weapons (tanks, gas, etc.) must not fall into enemy hands.",
          "5. Mutiny or Severe Dissent: Extreme criticism of command or mentions of troops refusing to fight must be suppressed."
        ];

        const LETTERS = [
          {
            id: 1,
            sender: "Pte. Thomas Atkins",
            recipient: "Mrs. Mary Atkins",
            date: "28 June, 1916",
            chunks: [
              { id: '1-1', text: "My dearest Mary, ", isSensitive: false },
              { id: '1-2', text: "Thank you for the cake, though the trench rats got to half of it before I did. ", isSensitive: false },
              { id: '1-3', text: "The constant shellfire is enough to drive a man mad, but we are holding up. ", isSensitive: false, explanation: "General complaints about conditions and noise were usually allowed to pass." },
              { id: '1-4', text: "We have been ordered to march towards Albert tonight, ", isSensitive: true, explanation: "Specific locations (Albert) provide the enemy with troop placement intelligence." },
              { id: '1-5', text: "and rumor has it the ", isSensitive: false },
              { id: '1-6', text: "big push will finally happen on the 1st of July at 0730. ", isSensitive: true, explanation: "Exact times and dates of future attacks are highly classified and could lead to a massacre if intercepted." },
              { id: '1-7', text: "The lads are nervous. ", isSensitive: false },
              { id: '1-8', text: "A German shell hit our dugout yesterday and we lost exactly 23 men from B Company. ", isSensitive: true, explanation: "Specific casualty numbers and company details damage home front morale and tell the enemy how effective their artillery is." },
              { id: '1-9', text: "Pray for me. Yours always, Tom.", isSensitive: false }
            ]
          },
          {
            id: 2,
            sender: "Cpl. James Miller",
            recipient: "Mrs. Sarah Miller",
            date: "15 October, 1917",
            chunks: [
              { id: '2-1', text: "Dear Mother, ", isSensitive: false },
              { id: '2-2', text: "The rain here in Flanders hasn't stopped for weeks. We are living in a sea of liquid mud. ", isSensitive: false, explanation: "General descriptions of weather and mud, while depressing, were not considered intelligence breaches." },
              { id: '2-3', text: "I am currently stationed in the Ypres Salient, near Passchendaele ridge. ", isSensitive: true, explanation: "Revealing specific tactical positions (Ypres Salient/Passchendaele) is dangerous." },
              { id: '2-4', text: "My boots have rotted completely through, ", isSensitive: false },
              { id: '2-5', text: "but the quartermaster has nothing to give us. ", isSensitive: false },
              { id: '2-6', text: "Honestly, ", isSensitive: false },
              { id: '2-7', text: "the men are at their breaking point. Half my platoon says they will refuse to go over the top again. ", isSensitive: true, explanation: "Talk of mutiny or refusing orders was heavily censored to prevent political unrest at home and hide low morale from the enemy." },
              { id: '2-8', text: "General Haig is sending us to the slaughter and the lads won't stand for it. ", isSensitive: true, explanation: "Severe criticism of high command was considered dangerous to the war effort." },
              { id: '2-9', text: "I hope to be home on leave soon. Love, James.", isSensitive: false }
            ]
          },
          {
            id: 3,
            sender: "Sgt. William Davies",
            recipient: "Mr. Thomas Davies",
            date: "10 September, 1916",
            chunks: [
              { id: '3-1', text: "Dear Father, ", isSensitive: false },
              { id: '3-2', text: "The tobacco you sent was a godsend. It helps mask the smell of the trench. ", isSensitive: false },
              { id: '3-3', text: "Things have been quiet on our sector, but ", isSensitive: false },
              { id: '3-4', text: "we are being moved up to the Flers-Courcelette line tonight. ", isSensitive: true, explanation: "Combining secret operations with specific locations/movements is a massive intelligence breach." },
              { id: '3-5', text: "There is a great deal of secrecy around here. ", isSensitive: false },
              { id: '3-6', text: "The engineers have brought up these strange new armoured motor-cars on caterpillar tracks. ", isSensitive: true, explanation: "Mentions of secret new technology (the first tanks) were strictly forbidden." },
              { id: '3-7', text: "They say these 'tanks' can crush barbed wire and cross trenches with ease. ", isSensitive: true, explanation: "Describing the specific capabilities of secret weapons gives the enemy an advantage in preparing defenses." },
              { id: '3-8', text: "I just hope they work better than the last lot of duds. ", isSensitive: false },
              { id: '3-9', text: "Tell Sarah I miss her. Your son, Will.", isSensitive: false }
            ]
          }
        ];

        function App() {
          const [gameState, setGameState] = useState('intro'); // intro, briefing, playing, review, results, analysis
          const [currentLetterIndex, setCurrentLetterIndex] = useState(0);
          const [redactedChunks, setRedactedChunks] = useState([]);
          const [score, setScore] = useState(0);
          const [stats, setStats] = useState({ correct: 0, missed: 0, overCensored: 0 });
          const [lastReview, setLastReview] = useState(null);
          const [showRulesModal, setShowRulesModal] = useState(false);

          const currentLetter = LETTERS[currentLetterIndex];

          const startGame = () => {
            setGameState('briefing');
          };

          const startLetters = () => {
            setGameState('playing');
          };

          const toggleRedaction = (id) => {
            setRedactedChunks(prev => 
              prev.includes(id) ? prev.filter(chunkId => chunkId !== id) : [...prev, id]
            );
          };

          const submitLetter = () => {
            let letterScore = 0;
            let correct = 0;
            let missed = 0;
            let over = 0;
            
            const reviewDetails = currentLetter.chunks.map(chunk => {
              const isRedacted = redactedChunks.includes(chunk.id);
              let status = 'neutral';
              
              if (chunk.isSensitive && isRedacted) {
                status = 'correct';
                letterScore += 10;
                correct++;
              } else if (chunk.isSensitive && !isRedacted) {
                status = 'missed';
                letterScore -= 10;
                missed++;
              } else if (!chunk.isSensitive && isRedacted) {
                status = 'over-censored';
                letterScore -= 5;
                over++;
              }

              return { ...chunk, status, isRedacted };
            });

            setScore(prev => prev + letterScore);
            setStats(prev => ({
              correct: prev.correct + correct,
              missed: prev.missed + missed,
              overCensored: prev.overCensored + over
            }));
            setLastReview({ details: reviewDetails, letterScore, correct, missed, over });
            setGameState('review');
          };

          const nextLetter = () => {
            setRedactedChunks([]);
            if (currentLetterIndex < LETTERS.length - 1) {
              setCurrentLetterIndex(prev => prev + 1);
              setGameState('playing');
            } else {
              setGameState('results');
            }
          };

          const restartGame = () => {
            setGameState('intro');
            setCurrentLetterIndex(0);
            setRedactedChunks([]);
            setScore(0);
            setStats({ correct: 0, missed: 0, overCensored: 0 });
          };

          const getRank = () => {
            const totalPossibleSensitive = LETTERS.reduce((acc, letter) => acc + letter.chunks.filter(c => c.isSensitive).length, 0);
            const maxPossibleScore = totalPossibleSensitive * 10;
            const percentage = score / maxPossibleScore;

            if (percentage > 0.8) return { title: "Director of Military Intelligence", desc: "Exceptional work. You have balanced home front morale with absolute military security.", color: "text-green-800" };
            if (percentage > 0.5) return { title: "Senior Censorship Officer", desc: "Good work. Some minor slip-ups, but the war effort is mostly safe in your hands.", color: "text-blue-800" };
            if (percentage > 0.2) return { title: "Junior Clerk", desc: "You let too much slip through or blacked out too much harmless text. You need more training.", color: "text-orange-800" };
            return { title: "Court-Martial Candidate", desc: "Disastrous! You have leaked vital intelligence to the enemy and caused panic on the home front.", color: "text-red-800" };
          };

          const IntroScreen = () => (
            <div className="flex flex-col items-center justify-center h-full text-center p-8 space-y-6">
              <Stamp size={80} className="text-gray-800 mb-4 opacity-80" />
              <h1 className="text-5xl font-bold font-serif text-gray-900 tracking-tight border-b-4 border-gray-900 pb-4">
                DEPARTMENT OF CENSORSHIP
              </h1>
              <h2 className="text-2xl font-semibold text-gray-700">Wartime Information Control Simulation</h2>
              <div className="max-w-xl space-y-4 mt-4">
                <p className="text-lg text-gray-600 leading-relaxed text-justify">
                  The year is 1916. The conflict has escalated into a 'Total War', requiring the absolute mobilization of society. The government recognizes that maintaining public morale on the Home Front is just as critical to victory as defeating the enemy in the trenches.
                </p>
                <p className="text-lg text-gray-600 leading-relaxed text-justify">
                  You have been appointed by the War Office as a military censor. Your duty is to read letters sent from the Western Front and redact any information that could aid the enemy or shatter public support for the war effort.
                </p>
              </div>
              <button onClick={startGame} className="mt-8 px-8 py-4 bg-gray-900 text-amber-50 font-bold text-xl rounded shadow-lg hover:bg-gray-800 transition flex items-center gap-2">
                Report for Duty <ChevronRight size={24} />
              </button>
            </div>
          );

          const BriefingScreen = () => (
            <div className="flex flex-col h-full p-8 max-w-3xl mx-auto overflow-y-auto">
              <div className="flex items-center justify-between mb-6 border-b-2 border-gray-400 pb-4 shrink-0">
                <div className="flex items-center gap-3">
                  <Shield size={32} className="text-gray-800" />
                  <h2 className="text-3xl font-bold font-serif">OFFICIAL BRIEFING: DORA</h2>
                </div>
                <button onClick={restartGame} className="text-gray-500 hover:text-red-800 transition flex items-center gap-1 font-bold text-sm" title="Restart Simulation">
                  <RotateCcw size={16} /> Restart
                </button>
              </div>
              <p className="text-lg mb-3 text-gray-800 font-medium text-justify shrink-0">
                By the authority of the <strong>Defence of the Realm Act (DORA)</strong>, enacted in August 1914, the government has assumed sweeping emergency powers to secure public safety and defend the empire. This includes the strict censorship of all civilian and military communications.
              </p>
              <p className="text-lg mb-6 text-gray-800 font-medium text-justify shrink-0">
                As an active censor operating under DORA regulations, you are authorized to intercept, read, and modify soldiers' mail. Click on any sensitive phrase to <span className="bg-black text-black px-1">black it out</span>.
              </p>
              <div className="bg-[#e8dec3] p-6 rounded shadow-inner border border-[#d1c5a9] shrink-0">
                <h3 className="text-xl font-bold mb-4 flex items-center gap-2">
                  <AlertTriangle size={24} className="text-red-800" /> Rules of Censorship
                </h3>
                <ul className="space-y-4 text-gray-800 font-serif text-lg">
                  {CENSORSHIP_RULES.map((rule, idx) => (
                    <li key={idx} className="text-justify">
                      <span className="font-bold mr-1">{rule.split(':')[0]}:</span>
                      <span>{rule.split(':')[1]}</span>
                    </li>
                  ))}
                </ul>
                <p className="mt-6 text-sm italic text-gray-600 text-justify">
                  Note: Do NOT censor general complaints (mud, bad food, missing home). We must allow letters to sound human, or the public will suspect we are hiding everything.
                </p>
              </div>
              <div className="mt-8 flex justify-end shrink-0 pb-4">
                <button onClick={startLetters} className="px-6 py-3 bg-gray-900 text-amber-50 font-bold text-lg rounded shadow hover:bg-gray-800 transition flex items-center gap-2">
                  To My Desk <ChevronRight size={20} />
                </button>
              </div>
            </div>
          );

          const GameScreen = () => (
            <div className="flex flex-col h-full p-6">
              <div className="flex justify-between items-center mb-6 border-b-2 border-gray-400 pb-4">
                <div>
                  <h2 className="text-2xl font-bold font-serif">Active File: Letter {currentLetterIndex + 1} of {LETTERS.length}</h2>
                  <p className="text-gray-600 font-mono text-sm">From: {currentLetter.sender} | Date: {currentLetter.date}</p>
                </div>
                <div className="flex gap-4 items-center">
                  <button onClick={restartGame} className="text-gray-500 hover:text-red-800 transition flex items-center gap-1 font-bold text-sm mr-2" title="Restart Simulation">
                    <RotateCcw size={16} /> Restart
                  </button>
                  <button onClick={() => setShowRulesModal(true)} className="bg-gray-800 hover:bg-gray-700 text-amber-50 px-3 py-2 rounded flex items-center gap-2 font-bold shadow transition">
                    <Info size={18} /> View Rules
                  </button>
                  <div className="bg-gray-200 px-4 py-2 rounded text-gray-800 font-mono font-bold shadow-inner flex items-center">
                    Total Score: {score}
                  </div>
                </div>
              </div>
              <div className="flex-1 bg-white p-8 rounded shadow-md border border-gray-300 overflow-y-auto mb-6 relative">
                <div className="absolute top-4 right-4 opacity-20 border-4 border-red-800 text-red-800 rounded px-2 py-1 transform rotate-12 font-bold font-serif text-xl">
                  CENSOR REVIEW
                </div>
                <p className="text-xl leading-loose font-serif text-gray-800">
                  {currentLetter.chunks.map((chunk) => (
                    <span key={chunk.id} onClick={() => toggleRedaction(chunk.id)} title="Click to toggle redaction"
                      className={`cursor-pointer rounded transition-colors duration-150 ${redactedChunks.includes(chunk.id) ? 'bg-black text-black select-none' : 'hover:bg-gray-300'}`}>
                      {chunk.text}
                    </span>
                  ))}
                </p>
              </div>
              <div className="flex justify-between items-center bg-gray-200 p-4 rounded border border-gray-300 mt-auto">
                <p className="text-gray-600 italic">Click phrases above to censor them.</p>
                <button onClick={submitLetter} className="px-8 py-3 bg-green-800 text-white font-bold rounded shadow hover:bg-green-700 transition flex items-center gap-2">
                  <Stamp size={20} /> Approve & Send
                </button>
              </div>
              {showRulesModal && (
                <div className="absolute inset-0 z-50 flex items-center justify-center bg-black bg-opacity-60 rounded-lg p-4">
                  <div className="bg-[#e8dec3] p-6 rounded shadow-2xl border border-[#d1c5a9] max-w-2xl w-full relative max-h-full overflow-y-auto">
                    <button onClick={() => setShowRulesModal(false)} className="absolute top-4 right-4 text-gray-800 hover:text-red-800 transition"><X size={24} /></button>
                    <h3 className="text-xl font-bold mb-4 flex items-center gap-2 text-gray-900 font-serif">
                      <AlertTriangle size={24} className="text-red-800" /> Rules of Censorship
                    </h3>
                    <ul className="space-y-4 text-gray-800 font-serif text-lg">
                      {CENSORSHIP_RULES.map((rule, idx) => (
                        <li key={idx} className="text-justify"><span className="font-bold mr-1">{rule.split(':')[0]}:</span><span>{rule.split(':')[1]}</span></li>
                      ))}
                    </ul>
                    <p className="mt-6 text-sm italic text-gray-600 text-justify">Note: Do NOT censor general complaints (mud, bad food, missing home). We must allow letters to sound human, or the public will suspect we are hiding everything.</p>
                  </div>
                </div>
              )}
            </div>
          );

          const ReviewScreen = () => (
            <div className="flex flex-col h-full p-6">
              <div className="flex justify-between items-center mb-6 relative">
                <h2 className="text-3xl font-bold font-serif text-center w-full">Censorship Review</h2>
                <button onClick={restartGame} className="text-gray-500 hover:text-red-800 transition flex items-center gap-1 font-bold text-sm absolute right-0" title="Restart Simulation">
                  <RotateCcw size={16} /> Restart
                </button>
              </div>
              <div className="flex justify-center gap-8 mb-8">
                <div className="text-center p-4 bg-green-100 rounded shadow border border-green-300 w-32">
                  <CheckCircle className="mx-auto text-green-600 mb-2" size={32} />
                  <div className="text-2xl font-bold text-green-800">+{lastReview.correct * 10}</div>
                  <div className="text-sm text-green-700">Protected</div>
                </div>
                <div className="text-center p-4 bg-red-100 rounded shadow border border-red-300 w-32">
                  <AlertTriangle className="mx-auto text-red-600 mb-2" size={32} />
                  <div className="text-2xl font-bold text-red-800">-{lastReview.missed * 10}</div>
                  <div className="text-sm text-red-700">Leaked</div>
                </div>
                <div className="text-center p-4 bg-orange-100 rounded shadow border border-orange-300 w-32">
                  <XCircle className="mx-auto text-orange-600 mb-2" size={32} />
                  <div className="text-2xl font-bold text-orange-800">-{lastReview.over * 5}</div>
                  <div className="text-sm text-orange-700">Over-Censored</div>
                </div>
              </div>
              <div className="flex-1 bg-white p-6 rounded shadow-md border border-gray-300 overflow-y-auto mb-6 text-lg leading-relaxed font-serif">
                {lastReview.details.map((chunk) => {
                  let chunkClass = "";
                  if (chunk.status === 'correct') chunkClass = "bg-green-200 border-b-2 border-green-500";
                  else if (chunk.status === 'missed') chunkClass = "bg-red-200 border-b-2 border-red-500 font-bold";
                  else if (chunk.status === 'over-censored') chunkClass = "bg-orange-200 border-b-2 border-orange-500 line-through";

                  return (
                    <span key={chunk.id} className="relative group">
                      <span className={`rounded ${chunkClass}`}>{chunk.text}</span>
                      {chunk.explanation && (chunk.status === 'missed' || chunk.status === 'correct' || chunk.status === 'over-censored') && (
                        <span className="absolute bottom-full left-1/2 transform -translate-x-1/2 mb-2 hidden group-hover:block w-64 p-2 bg-gray-900 text-white text-sm rounded shadow-xl z-10">
                          <span className="font-bold uppercase text-xs mb-1 block">
                            {chunk.status === 'correct' ? 'Good Catch:' : chunk.status === 'missed' ? 'Intelligence Leak:' : 'Unnecessary:'}
                          </span>
                          {chunk.explanation}
                        </span>
                      )}
                    </span>
                  );
                })}
              </div>
              <div className="flex justify-end">
                <button onClick={nextLetter} className="px-8 py-3 bg-gray-900 text-white font-bold rounded shadow hover:bg-gray-800 transition flex items-center gap-2">
                  {currentLetterIndex < LETTERS.length - 1 ? 'Next Letter' : 'View Final Evaluation'} <ChevronRight size={20} />
                </button>
              </div>
            </div>
          );

          const ResultsScreen = () => {
            const rank = getRank();
            return (
              <div className="flex flex-col items-center justify-center h-full p-8 text-center space-y-6 overflow-y-auto">
                <Award size={80} className={rank.color} />
                <h1 className="text-4xl font-bold font-serif">Final Evaluation</h1>
                <div className="bg-white p-8 rounded shadow-lg border-2 border-gray-300 w-full max-w-2xl mt-4">
                  <h2 className="text-gray-500 font-bold tracking-widest text-sm uppercase mb-2">Assigned Rank</h2>
                  <h3 className={`text-4xl font-bold font-serif mb-4 ${rank.color}`}>{rank.title}</h3>
                  <p className="text-xl text-gray-700 italic mb-8 border-b pb-8">"{rank.desc}"</p>
                  <div className="grid grid-cols-3 gap-4 text-center">
                    <div className="bg-gray-100 p-4 rounded">
                      <div className="text-3xl font-bold text-gray-800">{stats.correct}</div>
                      <div className="text-sm text-gray-600 uppercase tracking-wide">Threats Stopped</div>
                    </div>
                    <div className="bg-gray-100 p-4 rounded">
                      <div className="text-3xl font-bold text-red-600">{stats.missed}</div>
                      <div className="text-sm text-gray-600 uppercase tracking-wide">Leaks Allowed</div>
                    </div>
                    <div className="bg-gray-100 p-4 rounded">
                      <div className="text-3xl font-bold text-orange-600">{stats.overCensored}</div>
                      <div className="text-sm text-gray-600 uppercase tracking-wide">Over-censored</div>
                    </div>
                  </div>
                  <div className="mt-8 pt-6 border-t border-gray-300">
                    <h4 className="text-gray-500 font-bold tracking-widest text-sm uppercase mb-2">Final Score</h4>
                    <div className="text-5xl font-mono font-bold text-gray-900">{score}</div>
                  </div>
                </div>
                <div className="flex gap-4 mt-8 pb-4">
                  <button onClick={restartGame} className="px-6 py-3 border-2 border-gray-900 text-gray-900 font-bold rounded hover:bg-gray-900 hover:text-white transition flex items-center gap-2">
                    <RotateCcw size={20} /> Replay
                  </button>
                  <button onClick={() => setGameState('analysis')} className="px-6 py-3 bg-gray-900 text-amber-50 font-bold rounded shadow hover:bg-gray-800 transition flex items-center gap-2">
                    Proceed to Historical Analysis <ChevronRight size={20} />
                  </button>
                </div>
              </div>
            );
          };

          const AnalysisScreen = () => (
            <div className="flex flex-col h-full p-8 max-w-4xl mx-auto overflow-y-auto">
              <div className="flex items-center justify-between mb-6 border-b-2 border-gray-400 pb-4 shrink-0">
                <div className="flex items-center gap-3">
                  <BookOpen size={32} className="text-gray-800" />
                  <h2 className="text-3xl font-bold font-serif">HISTORIAN'S DEBRIEF</h2>
                </div>
                <button onClick={restartGame} className="text-gray-500 hover:text-red-800 transition flex items-center gap-1 font-bold text-sm" title="Restart Simulation">
                  <RotateCcw size={16} /> Restart
                </button>
              </div>
              <p className="text-xl mb-6 text-gray-800 font-medium text-justify shrink-0">
                You have now stepped out of the role of the wartime censor and back into the role of a Modern Historian. Use your experience in this simulation to respond to the following questions in your workbook.
              </p>
              <div className="space-y-6 shrink-0 pb-6">
                <div className="bg-white p-6 rounded shadow-md border border-gray-300 relative">
                  <div className="absolute -top-3 -left-3 bg-gray-900 text-white w-8 h-8 flex items-center justify-center rounded-full font-bold">1</div>
                  <h3 className="font-bold text-xl mb-2 text-gray-900 font-serif">Source Reliability & Usefulness</h3>
                  <p className="text-gray-700 text-lg">If letters from the front were systematically altered by censors to remove tactical failures, low morale, and exact casualty numbers, <strong>evaluate the usefulness and reliability of published soldiers' letters as historical evidence of trench warfare.</strong> What are the limitations of these sources?</p>
                </div>
                <div className="bg-white p-6 rounded shadow-md border border-gray-300 relative">
                  <div className="absolute -top-3 -left-3 bg-gray-900 text-white w-8 h-8 flex items-center justify-center rounded-full font-bold">2</div>
                  <h3 className="font-bold text-xl mb-2 text-gray-900 font-serif">The Nature of Total War</h3>
                  <p className="text-gray-700 text-lg">The Defence of the Realm Act (DORA) stripped British citizens of basic freedoms (like free speech and privacy) in the name of national security. <strong>To what extent can a government justify authoritarian controls in a democracy during a 'Total War'?</strong></p>
                </div>
                <div className="bg-white p-6 rounded shadow-md border border-gray-300 relative">
                  <div className="absolute -top-3 -left-3 bg-gray-900 text-white w-8 h-8 flex items-center justify-center rounded-full font-bold">3</div>
                  <h3 className="font-bold text-xl mb-2 text-gray-900 font-serif">Constructing the Narrative</h3>
                  <p className="text-gray-700 text-lg">By allowing soldiers to complain about "mud and bad food" (to sound human) but forbidding mentions of "mutiny and mass casualties", what kind of <strong>historical narrative</strong> was the government actively constructing for the home front?</p>
                </div>
              </div>
            </div>
          );

          const NavBar = () => {
            const navItems = [
              { id: 'intro', label: 'Home', icon: <Stamp size={16} /> },
              { id: 'briefing', label: 'Briefing', icon: <Shield size={16} /> },
              { id: 'playing', label: 'The Desk', icon: <FileText size={16} /> },
              { id: 'results', label: 'Evaluation', icon: <Award size={16} /> },
              { id: 'analysis', label: 'Analysis', icon: <BookOpen size={16} /> }
            ];

            return (
              <div className="bg-[#2c1e16] text-[#d1c5a9] flex justify-between items-center px-6 py-3 shrink-0 shadow-md border-b-4 border-[#1a120c] z-10 relative">
                <div className="font-serif font-bold text-amber-50 tracking-widest uppercase flex items-center gap-2">
                  War Office Dept.
                </div>
                <div className="flex gap-2">
                  {navItems.map(item => {
                    const isActive = gameState === item.id || (item.id === 'playing' && gameState === 'review');
                    return (
                      <button key={item.id} onClick={() => setGameState(item.id)} className={`flex items-center gap-2 px-3 py-1.5 rounded font-serif text-sm transition-colors ${isActive ? 'bg-[#f4ecd8] text-[#2c1e16] font-bold shadow-inner' : 'hover:bg-[#4a3628] text-[#d1c5a9]'}`}>
                        {item.icon} <span className="hidden sm:inline">{item.label}</span>
                      </button>
                    );
                  })}
                </div>
              </div>
            );
          };

          return (
            <div className="h-full bg-gray-900 flex items-center justify-center p-4 font-sans">
              <div className="w-full max-w-4xl h-[800px] max-h-full bg-[#f4ecd8] rounded-lg shadow-2xl overflow-hidden relative text-[#2c1e16] flex flex-col">
                <NavBar />
                <div className="flex-1 overflow-hidden relative">
                  {gameState === 'intro' && <IntroScreen />}
                  {gameState === 'briefing' && <BriefingScreen />}
                  {gameState === 'playing' && <GameScreen />}
                  {gameState === 'review' && <ReviewScreen />}
                  {gameState === 'results' && <ResultsScreen />}
                  {gameState === 'analysis' && <AnalysisScreen />}
                </div>
              </div>
            </div>
          );
        }

        const root = ReactDOM.createRoot(document.getElementById('root'));
        root.render(<App />);
    </script>
</body>
</html>
